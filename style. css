
:root {
  color-scheme: dark;
  --bg: #101018;
  --panel: #191923;
  --panel2: #222231;
  --text: #f5f3ff;
  --muted: #9a9aae;
  --purple: #a78bfa;
  --cyan: #67e8f9;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, sans-serif;
  padding-bottom: 85px;
}
button, input { font: inherit; }
button { cursor: pointer; color: inherit; }
.topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 17px 20px; border-bottom: 1px solid #292936;
  position: sticky; top: 0; background: #101018ed; z-index: 5;
}
.brand { display: flex; align-items: center; gap: 10px;
  font-weight: 900; letter-spacing: 2px; }
.logo {
  display: grid; place-items: center; width: 36px; height: 36px;
  border-radius: 12px; background: linear-gradient(135deg,#a78bfa,#67e8f9);
  color: #101018; font-size: 22px;
}
.avatar {
  border: 1px solid #51446e; background: #302541;
  border-radius: 50%; width: 38px; height: 38px;
}
main { max-width: 650px; margin: auto; padding: 20px; }
.welcome {
  padding: 27px 21px; border: 1px solid #39304c; border-radius: 24px;
  background: radial-gradient(ellipse at top right,#403064 0%,transparent 65%),
              linear-gradient(135deg,#211d31,#171720);
}
.eyebrow { color: var(--cyan); font-size: 10px; letter-spacing: 2px;
  font-weight: 800; }
h1 { font-size: clamp(34px,9vw,49px); line-height: 1.1;
  letter-spacing: -1.8px; margin: 18px 0 12px; }
h1 span { color: var(--purple); }
.sub, small, .hint { color: var(--muted); }
.sub { font-size: 13px; }
.search {
  display: flex; gap: 12px; align-items: center; margin: 20px 0 28px;
  padding: 13px 16px; border-radius: 14px; background: var(--panel);
  border: 1px solid #292936;
}
.search input, .composer input {
  width: 100%; min-width: 0; background: transparent; border: 0;
  outline: 0; color: var(--text);
}
.section { margin: 28px 0; }
.section-heading { display: flex; align-items: center;
  justify-content: space-between; margin-bottom: 14px; }
h2 { font-size: 17px; margin: 0; }
.text-btn { color: var(--cyan); background: none; border: 0; }
.server-list { display: grid; gap: 9px; }
.server {
  display: flex; align-items: center; text-align: left; gap: 12px;
  width: 100%; padding: 13px; border-radius: 15px;
  border: 1px solid #292936; background: var(--panel);
}
.server.active { border-color: #8b70ce; background: #282238; }
.server span:nth-child(2), .chat-title div { display: grid; gap: 4px; }
.server b, .chat-title b { font-size: 13px; }
.server small, .chat-title small { font-size: 11px; }
.server-icon { display: grid; place-items: center; flex-shrink: 0;
  width: 43px; height: 43px; border-radius: 14px; font-weight: 900; }
.purple { background: #3b2d58; color: #c4b5fd; }
.blue { background: #203b53; color: #7dd3fc; }
.pink { background: #512b49; color: #f9a8d4; }
.dot { width: 7px; height: 7px; background: #6ee7b7;
  border-radius: 50%; margin-left: auto; }
.live { font-size: 9px; color: #6ee7b7; letter-spacing: 1px; }
.chat-card { background: var(--panel); border: 1px solid #302d41;
  border-radius: 20px; padding: 15px; }
.chat-title { display: flex; gap: 11px; align-items: center;
  padding-bottom: 15px; border-bottom: 1px solid #302d3d; }
.messages { min-height: 130px; padding: 14px 0; }
.system { color: var(--cyan); font-size: 11px; }
.bubble { width: fit-content; max-width: 90%; padding: 11px 13px;
  border-radius: 4px 14px 14px; background: var(--panel2);
  font-size: 13px; overflow-wrap: anywhere; }
.composer { display: flex; gap: 10px; padding: 9px;
  background: #101018; border-radius: 13px; }
.composer input { padding: 5px; }
.composer button { background: var(--purple); color: #171222;
  border: 0; border-radius: 10px; min-width: 39px; }
.hint { font-size: 10px; }
.feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.feature { display: grid; gap: 9px; background: var(--panel);
  border: 1px solid #292936; padding: 17px; border-radius: 16px; }
.feature span { color: var(--cyan); font-size: 22px; }
.feature b { font-size: 13px; }
.feature small { font-size: 11px; }
.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 10;
  display: flex; justify-content: space-around; padding: 11px 4px;
  background: #15151fee; border-top: 1px solid #302d3d;
  padding-bottom: max(11px, env(safe-area-inset-bottom));
}
.nav-item { display: grid; gap: 4px; justify-items: center;
  background: none; border: 0; color: var(--muted); font-size: 20px; }
.nav-item small { font-size: 10px; }
.nav-item.selected { color: var(--purple); }
@media (min-width: 600px) {
  main { padding-top: 30px; }
}
